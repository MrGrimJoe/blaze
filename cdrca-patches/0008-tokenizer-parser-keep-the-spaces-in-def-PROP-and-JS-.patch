From bc990b814885eb4f611b631b4aef4c51d9ca4e69 Mon Sep 17 00:00:00 2001
From: "Claude (for MrMIB)" <noreply@anthropic.com>
Date: Sun, 4 Oct 2026 10:22:30 +0000
Subject: [PATCH 08/11] tokenizer/parser: keep the spaces in def PROP and JS
 bodies

Code inside '{ ... }' of 'def PROP' / 'JS' / plugin definitions was rebuilt with tokens.join(''), and the
tokenizer drops whitespace, so 'const word of x' became 'constwordofx' and any prop with real code in it
was a syntax error. Two parts:

- Tokenizer: a token records spaceBefore when the source had a space or tab right before it. The clean-up pass
  (cleanTheTokens) no longer glues single characters that were separated by whitespace into one word, and keeps
  the flag on the tokens it merges.
- Parser: bodies are put back together with a joinCode() helper that writes a space where the source had one.

Everything that only reads token values is unaffected; the flag is an extra property. Test added.
---
 Back-end/Transpiler/Parser.js    | 12 ++++++--
 Back-end/Transpiler/Tokenizer.js | 51 +++++++++++++++-----------------
 tests/transpiler.test.js         |  8 +++++
 3 files changed, 41 insertions(+), 30 deletions(-)

diff --git a/Back-end/Transpiler/Parser.js b/Back-end/Transpiler/Parser.js
index 43ccbde..6f10d4b 100644
--- a/Back-end/Transpiler/Parser.js
+++ b/Back-end/Transpiler/Parser.js
@@ -469,7 +469,7 @@ const parserConstructor = function (defaultTokenizer, pluginAPI) {
         throw new Error("Unclosed plugin definition block");
       }
 
-      const body = bodyTokens.map((t) => t.value).join("");
+      const body = joinCode(bodyTokens);
       return {
         type: "PLUGIN_DEF",
         prams: {
@@ -499,6 +499,12 @@ const parserConstructor = function (defaultTokenizer, pluginAPI) {
       return { type, prams: { values: Array.from(new Set(values)) }, newPosition: pos };
     }
 
+    // Code captured from a { ... } body: put the tokens back together, keeping a space wherever the source had one
+    // (joining with "" turned 'const word of x' into 'constwordofx').
+    function joinCode(tokens) {
+      return tokens.map((t) => (t.spaceBefore ? " " : "") + t.value).join("");
+    }
+
     function parseImport(tokens, pos, type) {
       // console.log(type);
       pos++;
@@ -524,7 +530,7 @@ const parserConstructor = function (defaultTokenizer, pluginAPI) {
         pos++;
       }
       if (depth !== 0) throw new Error("Unclosed JS block");
-      const code = codeTokens.map((t) => t.value).join("");
+      const code = joinCode(codeTokens);
       return { type: "JS_BLOCK", prams: { code }, newPosition: pos };
     }
 
@@ -575,7 +581,7 @@ const parserConstructor = function (defaultTokenizer, pluginAPI) {
         pos++;
       }
       if (depth !== 0) throw new Error("Unclosed prop definition");
-      const code = codeTokens.map((t) => t.value).join("");
+      const code = joinCode(codeTokens);
       return {
         type: "PROP_DEF",
         prams: { name, abstracts, optionOtherPROP, code },
diff --git a/Back-end/Transpiler/Tokenizer.js b/Back-end/Transpiler/Tokenizer.js
index 731b2f4..22926b1 100644
--- a/Back-end/Transpiler/Tokenizer.js
+++ b/Back-end/Transpiler/Tokenizer.js
@@ -229,6 +229,9 @@ var create_Tokenizer = function () {
     let tokens = [];
     let STRindex = 0;
     let LOGs = [];
+    // whitespace is skipped, but a token remembers that some came right before it (spaceBefore) so code
+    // captured from a { ... } body (def PROP, JS) can be put back together without gluing words together
+    const spaceBefore = (i) => i > 0 && (str[i - 1] === " " || str[i - 1] === "\t" || str[i - 1] === "\r");
 
     while (STRindex < str.length) {
       Utilities.log(
@@ -281,6 +284,7 @@ var create_Tokenizer = function () {
           continue;
         } else {
           const token = { type: bestMatch.type, value: bestMatch.value };
+          if (spaceBefore(STRindex)) token.spaceBefore = true;
           tokens.push(token);
           Utilities.log(`Token created: ${JSON.stringify(token)}`, "info");
           STRindex += bestMatch.length;
@@ -291,6 +295,7 @@ var create_Tokenizer = function () {
       // If no match, treat as unknown
       let chunk = str[STRindex];
       const unknownToken = { type: "unknown", value: chunk };
+      if (spaceBefore(STRindex)) unknownToken.spaceBefore = true;
       tokens.push(unknownToken);
       const warning = "Unrecognized character: " + chunk;
       LOGs.push({ warn: warning });
@@ -388,54 +393,46 @@ let OAS_TOKobj = {
 function cleanTheTokens(tokens) {
   let cleanedTokens = [];
   let currentValue = "";
+  let currentSpace = false; // did whitespace come right before the first character of currentValue
 
   function determineType(token) {
     return token.type;
   }
 
+  // push the characters gathered so far as one token (typed like the token that ended them, as before)
+  function flush(endedBy) {
+    if (currentValue !== "") {
+      const merged = { type: determineType(endedBy), value: currentValue };
+      if (currentSpace) merged.spaceBefore = true;
+      cleanedTokens.push(merged);
+      currentValue = "";
+      currentSpace = false;
+    }
+  }
+
   for (let i = 0; i < tokens.length; i++) {
     const token = tokens[i];
     if (token.value === " ") {
-      if (currentValue !== "") {
-        cleanedTokens.push({
-          type: determineType(token),
-          value: currentValue,
-        });
-        currentValue = "";
-      }
+      flush(token);
       continue;
     } else if (token.value.length > 1) {
-      if (currentValue !== "") {
-        cleanedTokens.push({
-          type: determineType(token),
-          value: currentValue,
-        });
-        currentValue = "";
-      }
+      flush(token);
       cleanedTokens.push(token);
     } else if (
       token.value.length === 1 &&
       /[a-zA-Z0-9_"'`]/.test(token.value)
     ) {
+      // characters separated by whitespace are separate words (they used to be glued together)
+      if (token.spaceBefore) flush(token);
+      if (currentValue === "") currentSpace = Boolean(token.spaceBefore);
       currentValue += token.value;
     } else {
-      if (currentValue !== "") {
-        cleanedTokens.push({
-          type: determineType(token),
-          value: currentValue,
-        });
-        currentValue = "";
-      }
+      flush(token);
       cleanedTokens.push(token);
     }
   }
 
-  if (currentValue !== "") {
-    cleanedTokens.push({
-      type: determineType(tokens[tokens.length - 1]),
-      value: currentValue,
-    });
-  }
+  flush(tokens[tokens.length - 1]);
 
   return cleanedTokens;
 }
diff --git a/tests/transpiler.test.js b/tests/transpiler.test.js
index 048f8e2..9c75237 100644
--- a/tests/transpiler.test.js
+++ b/tests/transpiler.test.js
@@ -61,4 +61,12 @@ test("JS { } blocks are emitted (they were parsed, then dropped), before the def
   }
 });
 
+test("def PROP / JS bodies keep the spaces between words (they were glued together)", () => {
+  const js = run("def PROP Tiny {\n  constructor(a) { super(); for (const word of String(a).split(\" \")) { this.last = word; } }\n  size() { let total = 0; return total + 1; }\n}\nJS { const answer = 40 + 2; globalThis.zz = answer; }\n");
+  assert(/for \(const word of String/.test(js), "'const word of' must not become 'constwordof'");
+  assert(/let total = 0; return total \+ 1/.test(js));
+  assert(/const answer = 40 \+ 2/.test(js));
+  new Function("class Prop{}; const mixClasses=(c)=>c[0];" + js.replace(/ObjectAnimationSystem_INS\.CORE_3d_PROPSsceneSYS\.Prop/g, "Prop")); // parses as JavaScript
+});
+
 console.log("\n" + n + " tests passed");
