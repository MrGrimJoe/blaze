// atoms.cdrca - two general-purpose props written in CDRCA itself (def PROP). Nothing here is built into the
// language. Every value is an explicit number or a literal: positions and sizes in scene units, colours as
// 0xRRGGBB, times in seconds, speeds in units per second. No names like "left" or "style".
//
// Picture(src, x, y, w, h, z, speed, altSrc, flapHz)
//   src, altSrc  image paths (relative to the script); altSrc may be "" when there is no second picture
//   x, y         centre of the picture;  w, h  its width and height;  z  depth (more negative = further away)
//   speed        units per second used by moveTo;  flapHz  how many times per second flap swaps src/altSrc
//   actions (single parameter each):
//     modifyMesh ""   stand at (x, y) with src          moveTo 3.5   walk in a straight line to x = 3.5
//     flap ""         stand, swapping src/altSrc          hide ""      not drawn during this action
//     hop 0.5         jump once, this many units high
//
// Words(x, y, ax, ay, size, wrapW, fill, fillAlpha, ink, border, borderW, pad, tail, z, limit, limitY)
//   x, y         where the anchor point goes;  ax, ay  the anchor inside the box, 0..1 from its left / bottom
//   size         height of one line of text;  wrapW  widest a line may be (scene units)
//   fill, fillAlpha, ink, border   box colour, its opacity 0..1, text colour, outline colour (0xRRGGBB)
//   borderW      outline width, pad  space between text and box edge (scene units);  tail  length of a pointer
//                drawn under the box ending at the anchor (0 = none);  z  depth
//   limit        the box never reaches past x = -limit or x = +limit: it slides back on screen and the pointer
//                keeps pointing at the anchor (0 = no limit)
//   limitY       the box never reaches above y = limitY (it is pushed down instead; 0 = no limit)
//   actions:
//     rate 24      characters revealed per second by later say actions in this prop (0 = all at once)
//     say "text"   show the text, revealing it at the current rate from the moment the action starts
//     hide ""      not drawn during this action (modifyMesh is the same)

!--- PROP Picture :: image atom ---

def PROP Picture {
  constructor(src, x, y, w, h, z, speed, altSrc, flapHz) {
    super();
    this.src = src; this.altSrc = altSrc; this.x = x; this.y = y; this.w = w; this.h = h; this.z = z;
    this.speed = speed; this.flapHz = flapHz;
    this.walk = null;
    // Textures are NOT kept on the prop: the renderer deep-clones every prop for every action, and cloning loaded
    // images made scripts with many actions crash the page. They live in Picture.cache, looked up by path.
  }
  static load(src) {
    if (!Picture.cache) Picture.cache = {};
    if (!Picture.cache[src]) Picture.cache[src] = new THREE.TextureLoader().load(src);
    return Picture.cache[src];
  }
  frame(i) {
    return Picture.load(i === 1 && this.altSrc ? this.altSrc : this.src);
  }
  getObjectConfig() {
    return {
      Geometry: new THREE.PlaneGeometry(1, 1),
      Material: new THREE.MeshBasicMaterial({ map: this.frame(0), transparent: true, depthWrite: false, side: THREE.DoubleSide, visible: false }),
      outline: { render: false, color: 0x000000, opacity: 0 },
      createMesh: true,
      modifier: { mesh: this.modifyMesh.bind(this) },
    };
  }
  put(mesh, x, frame) {
    mesh.material.map = this.frame(frame);
    mesh.material.visible = true;
    mesh.scale.set(this.w, this.h, 1);
    mesh.position.set(x, this.y, this.z);
    return mesh;
  }
  modifyMesh(mesh) {
    this.walk = null;
    this.hopT0 = null;
    return this.put(mesh, this.x, 0);
  }
  hop(mesh, totalTime, lerpProgress, step, height) {
    if (this.hopT0 === null || this.hopT0 === undefined) this.hopT0 = totalTime;
    const u = Math.min(1, (totalTime - this.hopT0) / 0.4);
    this.put(mesh, this.x, 0);
    mesh.position.y = this.y + Math.sin(Math.PI * u) * height;
    return mesh;
  }
  flap(mesh, totalTime) {
    this.walk = null;
    this.hopT0 = null;
    return this.put(mesh, this.x, Math.floor(totalTime * this.flapHz * 2) % 2);
  }
  moveTo(mesh, totalTime, lerpProgress, step, x) {
    if (!this.walk || this.walk.to !== x) this.walk = { to: x, from: this.x, t0: totalTime };
    const w = this.walk;
    const dist = Math.abs(w.to - w.from);
    const p = dist === 0 ? 1 : Math.min(1, ((totalTime - w.t0) * this.speed) / dist);
    if (p >= 1) this.x = w.to;
    return this.put(mesh, w.from + (w.to - w.from) * p, 0);
  }
  hide(mesh) {
    mesh.material.visible = false;
    return mesh;
  }
}

!---END---

!--- PROP Words :: text atom ---

def PROP Words {
  constructor(x, y, ax, ay, size, wrapW, fill, fillAlpha, ink, border, borderW, pad, tail, z, limit, limitY) {
    super();
    this.x = x; this.y = y; this.ax = ax; this.ay = ay; this.size = size; this.wrapW = wrapW;
    this.fill = fill; this.fillAlpha = fillAlpha; this.ink = ink; this.border = border; this.borderW = borderW;
    this.pad = pad; this.tail = tail; this.z = z; this.limit = limit || 0; this.limitY = limitY || 0;
    this.cps = 0;
    this.cur = null;
  }
  getObjectConfig() {
    return {
      Geometry: new THREE.PlaneGeometry(1, 1),
      Material: new THREE.MeshBasicMaterial({ transparent: true, depthWrite: false, depthTest: false, side: THREE.DoubleSide, visible: false }),
      outline: { render: false, color: 0x000000, opacity: 0 },
      createMesh: true,
      modifier: { mesh: this.modifyMesh.bind(this) },
    };
  }
  css(n, a) {
    return "rgba(" + ((n >> 16) & 255) + "," + ((n >> 8) & 255) + "," + (n & 255) + "," + a + ")";
  }
  layout(text) {
    const PX = 64;
    const k = PX / this.size;
    const font = "700 " + PX + 'px "Segoe UI","Helvetica Neue",Arial,"DejaVu Sans",sans-serif';
    const probe = document.createElement("canvas").getContext("2d");
    probe.font = font;
    const maxW = this.wrapW * k;
    const lines = [];
    let line = "";
    for (const word of String(text).split(/\s+/).filter(Boolean)) {
      const trial = line ? line + " " + word : word;
      if (line && probe.measureText(trial).width > maxW) { lines.push(line); line = word; } else line = trial;
    }
    if (line) lines.push(line);
    const pad = this.pad * k, bw = this.borderW * k, tail = this.tail * k, lh = PX * 1.25;
    const textW = Math.max(1, ...lines.map((l) => probe.measureText(l).width));
    const boxW = Math.ceil(textW + pad * 2), boxH = Math.ceil(lines.length * lh + pad * 2);
    const canvas = document.createElement("canvas");
    canvas.width = boxW + Math.ceil(bw * 2);
    canvas.height = boxH + Math.ceil(tail) + Math.ceil(bw * 2);
    const tex = new THREE.Texture(canvas);
    return { text: text, lines: lines, font: font, k: k, pad: pad, bw: bw, tail: tail, lh: lh, boxW: boxW, boxH: boxH,
             canvas: canvas, tex: tex, chars: lines.reduce((s, l) => s + l.length, 0), t0: 0, n: -1 };
  }
  paint(c, n) {
    const ctx = c.canvas.getContext("2d");
    ctx.clearRect(0, 0, c.canvas.width, c.canvas.height);
    const x0 = c.bw, y0 = c.bw, r = Math.min(c.pad, c.boxH / 2);
    ctx.beginPath();
    ctx.moveTo(x0 + r, y0); ctx.arcTo(x0 + c.boxW, y0, x0 + c.boxW, y0 + c.boxH, r);
    ctx.arcTo(x0 + c.boxW, y0 + c.boxH, x0, y0 + c.boxH, r); ctx.arcTo(x0, y0 + c.boxH, x0, y0, r);
    ctx.arcTo(x0, y0, x0 + c.boxW, y0, r); ctx.closePath();
    if (c.tail > 0) {
      const cx = x0 + c.boxW / 2 + (c.tailOff || 0);
      ctx.moveTo(cx - c.tail * 0.5, y0 + c.boxH); ctx.lineTo(cx, y0 + c.boxH + c.tail); ctx.lineTo(cx + c.tail * 0.5, y0 + c.boxH);
    }
    ctx.fillStyle = this.css(this.fill, this.fillAlpha);
    ctx.fill();
    if (c.bw > 0) { ctx.strokeStyle = this.css(this.border, 1); ctx.lineWidth = c.bw; ctx.stroke(); }
    ctx.font = c.font; ctx.textBaseline = "middle"; ctx.textAlign = "left"; ctx.fillStyle = this.css(this.ink, 1);
    let left = n;
    c.lines.forEach((l, i) => {
      if (left <= 0) return;
      ctx.fillText(l.slice(0, left), x0 + c.pad, y0 + c.pad + c.lh * (i + 0.5));
      left -= l.length;
    });
    c.tex.needsUpdate = true;
  }
  rate(mesh, totalTime, lerpProgress, step, cps) {
    this.cps = cps;
    return mesh;
  }
  say(mesh, totalTime, lerpProgress, step, text) {
    if (!this.cur || this.cur.text !== text) { this.cur = this.layout(text); this.cur.t0 = totalTime; }
    const c = this.cur;
    const n = this.cps > 0 ? Math.min(c.chars, Math.floor((totalTime - c.t0) * this.cps)) : c.chars;
    const u = this.size / 64;
    const w = c.canvas.width * u, h = c.canvas.height * u;
    // where the canvas centre goes in the world; slid back inside +-limit if needed (the tail then slants to the anchor)
    let centre = this.x + (0.5 - this.ax) * w;
    c.tailOff = 0;
    if (this.limit > 0) {
      const lo = -this.limit + w / 2, hi = this.limit - w / 2;
      const slid = lo > hi ? 0 : Math.min(hi, Math.max(lo, centre));
      const reach = Math.max(0, c.boxW / 2 - c.pad - c.tail * 0.5);
      c.tailOff = Math.max(-reach, Math.min(reach, (this.x - slid) / u));
      centre = slid;
    }
    if (n !== c.n) { this.paint(c, n); c.n = n; }
    mesh.material.map = c.tex;
    mesh.material.visible = true;
    mesh.material.needsUpdate = true;
    mesh.scale.set(w, h, 1);
    let middle = this.y + (0.5 - this.ay) * h;
    if (this.limitY > 0) middle = Math.min(middle, this.limitY - h / 2);
    mesh.position.set(centre, middle, this.z);
    mesh.renderOrder = 100;
    return mesh;
  }
  hide(mesh) {
    this.cur = null;
    mesh.material.visible = false;
    return mesh;
  }
  modifyMesh(mesh) {
    return this.hide(mesh);
  }
}

!---END---
